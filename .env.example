# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JUDGE0 / RAPIDAPI: (Optional) API Key for Judge0 execution provider via RapidAPI.
# If omitted, defaults to public Piston / Judge0 CE community tier.
RAPIDAPI_KEY=""
JUDGE0_URL="https://judge0-ce.p.rapidapi.com"

# UPSTASH REDIS: (Optional) Serverless Redis for distributed rate-limiting & cache.
# If omitted, uses fast in-memory sliding window rate limiter and cache.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# CLOUDFLARE TURNSTILE: (Optional) Bot protection keys.
# Obtain from Cloudflare Dashboard > Turnstile.
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
